-- Schéma 10 -> 11 (3.10.0) : additif. Calendriers importés (docs/spec/connexions-externes.md § Stockage).
-- NULL pour chaque créneau existant : il reste saisi à la main, et l'export ne change pas.
ALTER TABLE time_block ADD COLUMN source_id INTEGER;
ALTER TABLE time_block ADD COLUMN source_uid TEXT;
CREATE INDEX time_block_source ON time_block(source_id);
CREATE TABLE calendar_source (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    hide_titles INTEGER NOT NULL DEFAULT 0,
    imported_at TEXT NOT NULL,
    created_at TEXT NOT NULL
);
-- Journées entières des calendriers importés : vide.
CREATE TABLE day_mark (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL DEFAULT '',
    start TEXT NOT NULL,
    end TEXT NOT NULL,
    source_id INTEGER NOT NULL,
    source_uid TEXT NOT NULL,
    created_at TEXT NOT NULL
);
