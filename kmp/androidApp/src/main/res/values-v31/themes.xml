<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ : écran de démarrage système avec le cadran vide, statique ; la
         page de démarrage Compose (StartupSplash) enchaîne au même endroit et
         anime l'aiguille (docs/spec/demarrage.md). -->
    <style name="Theme.Kairos" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/kairos_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowSplashScreenBackground">@color/kairos_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/kairos_splash_dial</item>
    </style>
</resources>
