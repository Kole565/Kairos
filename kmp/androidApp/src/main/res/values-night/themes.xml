<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Système en sombre (docs/spec/apparence.md § Thème sombre) : fenêtre de démarrage sombre, icônes des barres
         claires. Le thème affiché ensuite est celui des réglages (KairosApp, MainActivity.applySystemBars). -->
    <style name="Theme.Kairos" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/kairos_launch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
</resources>
