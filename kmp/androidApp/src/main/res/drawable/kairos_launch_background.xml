<?xml version="1.0" encoding="utf-8"?>
<!-- Fond de fenêtre (android:windowBackground, themes.xml) : couleur de l'app
     et cadran vide centré dans une boîte de 288dp (kairos_splash_dial.xml).
     Avant l'API 31, c'est lui que le système affiche comme fenêtre de
     démarrage, du geste de lancement à la première image de MainActivity, où
     la page de démarrage Compose (StartupSplash) reprend le même cadran au même
     endroit (docs/spec/demarrage.md). À partir de l'API 31, l'écran de
     démarrage système le remplace pendant cette phase ; il reste dessous le
     contenu, toujours couvert. Dimensions d'élément de layer-list (API 23+,
     minSdk 24). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/kairos_bg" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:gravity="center"
        android:drawable="@drawable/kairos_splash_dial" />
</layer-list>
